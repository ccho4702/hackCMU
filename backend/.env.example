GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_VIDEO_MODEL=gemini-3.8-flash
GEMINI_SCRIPT_MODEL=gemini-3.8-flash
VIDEO_MAX_ATTEMPTS=3
ELEVENLABS_API_KEY=
ELEVENLABS_ASR_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=100
SCORING_CPU_THREADS=4
# Optional: FFMPEG_PATH=/absolute/path/to/ffmpeg
# Optional: ARTIFACTS_DIR=/absolute/path/to/local/artifacts

FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
ANALYZER=mediapipe
FACE_LANDMARKER_PATH=models/face_landmarker.task
TEMP_STORAGE_PATH=/tmp/mellonaires
MAX_UPLOAD_BYTES=524288000

# Optional MongoDB API: leave empty to keep local coaching usable without MongoDB.
MONGODB_URI=
MONGODB_DB=hackcmu
# Optional: DATA_DIR=/absolute/path/to/db/media (default: backend/artifacts/db-media)

# Gemini always uses Google Cloud; AI Studio does not use the $300 Welcome credit.
GEMINI_AUTH_MODE=adc
# For a portable service account: GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/credentials.json
# For an authorized Cloud API key: GEMINI_AUTH_MODE=vertex_api_key
VERTEX_API_KEY=
# Alternative to a JSON file: compact service-account JSON, inside single quotes.
# Keep private_key newlines escaped as \n inside the JSON string.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional: Cursor MCP / Vultr CLI (never commit the real key).
VULTR_API_KEY=
