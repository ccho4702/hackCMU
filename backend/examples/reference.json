    },
    {
      "id": "s1",
      "text": "The challenge was removing a speaker's voice from a trained model without retraining it from scratch.",
      "words": null,
      "audio": "6aa5181a3be1ec765046b666/references/6aa5182028cabf1587067879/s1.mp3",
      "wav": "6aa5181a3be1ec765046b666/references/6aa5182028cabf1587067879/s1.16k.wav",
